    <string name="sc_download">Download theme</string>

    <!-- Section titles & descriptions -->
    <string name="sc_s1_title">1 · Typography</string>
    <string name="sc_s1_desc">Material 3 scale with Geist. 15 steps, each with size/line-height/weight in the meta column.</string>
    <string name="sc_s2_title">2 · Font weights</string>
    <string name="sc_s2_desc">Geist offers the full weight range. Body 400, title/label 600, display/headline 700.</string>
    <string name="sc_s3_title">3 · Hue ramps</string>
    <string name="sc_s3_desc">Seven named ramps. 40 is the on-light accent, 80 the on-dark accent, 90 the on-light container.</string>
    <string name="sc_s4_title">4 · Surfaces &amp; outline</string>
    <string name="sc_s4_desc">Material 3 neutral palette. Light: off-white steps; dark: Abyss → Midnight → Dusk.</string>
    <string name="sc_s5_title">5 · Roles overview</string>
    <string name="sc_s5_desc">Each role provides four tokens: role, on-role, role-container, on-role-container.</string>
    <string name="sc_s6_title">6 · Buttons</string>
    <string name="sc_s6_desc">Five variants per role: filled, tonal, elevated, outlined, text. Plus disabled state.</string>
    <string name="sc_s7_title">7 · Floating action buttons</string>
    <string name="sc_s7_desc">FAB sits bottom-right, 16dp inset, only for the primary „create“ action.</string>
    <string name="sc_s8_title">8 · Icon buttons</string>
    <string name="sc_s8_desc">Four variants: standard, filled, tonal, outlined. At least 44dp touch target.</string>
    <string name="sc_s9_title">9 · Chips</string>
    <string name="sc_s9_desc">Four types: assist, filter (single-choice), input (with avatar &amp; close), suggestion.</string>
    <string name="sc_s10_title">10 · Text fields</string>
    <string name="sc_s10_desc">Outlined is default. Leading icon, error state, filled multiline, disabled.</string>
    <string name="sc_s11_title">11 · Cards</string>
    <string name="sc_s11_desc">Three variants: filled (on surface variant), elevated (with tonal elevation), outlined.</string>
    <string name="sc_s12_title">12 · List items</string>
    <string name="sc_s12_desc">One-, two- and three-line variants. Leading avatar 44dp, trail text in monospace.</string>
    <string name="sc_s13_title">13 · Selection controls</string>
    <string name="sc_s13_desc">Checkbox, switch, radio group. Native replacement with AA contrast.</string>
    <string name="sc_s14_title">14 · Segmented buttons</string>
    <string name="sc_s14_desc">Single-choice row for mutually exclusive selection (e.g. day / week / month / year).</string>
    <string name="sc_s15_title">15 · Slider &amp; progress</string>
    <string name="sc_s15_desc">Slider continuous / stepped / disabled. Progress linear &amp; circular, each determinate and indeterminate.</string>
    <string name="sc_s16_title">16 · Badges &amp; status pills</string>
    <string name="sc_s16_desc">Number badge on icon, dot badge, status pills for all roles.</string>
    <string name="sc_s17_title">17 · Banners</string>
    <string name="sc_s17_desc">Inline notice strips per role. With action, prominent style and a “✕” to dismiss.</string>
    <string name="sc_s18_title">18 · Snackbar &amp; dialog</string>
    <string name="sc_s18_desc">Snackbar with action button. Dialog with 28dp top radius.</string>
    <string name="sc_s19_title">19 · Icons</string>
    <string name="sc_s19_desc">On web: Lucide (same stroke, same style as Material Symbols).</string>
    <string name="sc_s20_title">20 · Dividers</string>
    <string name="sc_s20_desc">Horizontal / horizontal strong / vertical.</string>
    <string name="sc_s21_title">21 · Spacing &amp; radii</string>
    <string name="sc_s21_desc">8dp grid. Radii per M3 shape scale.</string>
    <string name="sc_s22_title">22 · App header (mobile)</string>
    <string name="sc_s22_desc">Taller top bar with a hairline at its base. Three buttons, each exactly one third wide; the icon sits directly above its label, centered as a unit. Right: gear (settings); center: app icon (home); left: a third icon for 2-page apps or a burger that expands into a drawer for multi-page apps.</string>
