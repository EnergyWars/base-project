    <!-- Showcase v2.1 -->
    <string name="sc_appbar_title">Showcase v2.1</string>
    <string name="sc_eyebrow">WaffleHQ · Design system v2.1 · Showcase</string>
    <string name="sc_title">Complete token &amp; component set</string>
    <string name="sc_lede">All tokens (color, type, shape, spacing) and every Material 3 component in one view — structured like the base project home screen. Every tinted foreground on its assigned surface meets at least WCAG 2.2 AA; the accent tones (40 light · 80 dark) are all in AAA range.</string>
    <string name="sc_toggle_light">Light</string>
