    <string name="sc_title">Vollständiges Token- &amp; Komponenten-Set</string>
    <string name="sc_lede">Alle Tokens (Farben, Typografie, Form, Spacing) und alle Material-3-Komponenten in einer Ansicht — gleich strukturiert wie der Home-Screen des Basisprojekts. Jeder eingefärbte Vordergrund auf seiner zugewiesenen Surface erfüllt mindestens WCAG 2.2 AA; die Akzent-Töne (40 hell · 80 dunkel) liegen ausnahmslos im AAA-Bereich.</string>
    <string name="sc_toggle_light">Hell</string>
    <string name="sc_toggle_dark">Dunkel</string>
    <string name="sc_download">Theme herunterladen</string>

    <!-- Section titles & descriptions -->
    <string name="sc_s1_title">1 · Typografie</string>
    <string name="sc_s1_desc">Material-3-Skala mit Geist. 15 Stufen, jeweils mit Größe/Line-Height/Weight in der Meta-Spalte.</string>
    <string name="sc_s2_title">2 · Schrift-Gewichte</string>
    <string name="sc_s2_desc">Geist liefert die volle Gewichts-Bandbreite. Body 400, Title/Label 600, Display/Headline 700.</string>
    <string name="sc_s3_title">3 · Hue-Rampen</string>
    <string name="sc_s3_desc">Sieben benannte Rampen. 40 ist der On-Light-Akzent, 80 der On-Dark-Akzent, 90 der On-Light-Container.</string>
    <string name="sc_s4_title">4 · Oberflächen &amp; Outline</string>
    <string name="sc_s4_desc">Material-3-Neutralpalette. Light: Off-White-Treppe; Dark: Abyss → Midnight → Dusk.</string>
    <string name="sc_s5_title">5 · Rollen-Übersicht</string>
    <string name="sc_s5_desc">Jede Rolle bietet vier Tokens: role, on-role, role-container, on-role-container.</string>
    <string name="sc_s6_title">6 · Buttons</string>
    <string name="sc_s6_desc">Fünf Varianten pro Rolle: Filled, Tonal, Elevated, Outlined, Text. Plus Disabled-State.</string>
    <string name="sc_s7_title">7 · Floating Action Buttons</string>
    <string name="sc_s7_desc">FAB ist bottom-right, 16dp Inset, nur für die primäre „Erstellen“-Aktion.</string>
    <string name="sc_s8_title">8 · Icon-Buttons</string>
    <string name="sc_s8_desc">Vier Varianten: Standard, Filled, Tonal, Outlined. Mindestens 44dp Touch-Target.</string>
    <string name="sc_s9_title">9 · Chips</string>
    <string name="sc_s9_desc">Vier Typen: Assist, Filter (single-choice), Input (mit Avatar &amp; Close), Suggestion.</string>
    <string name="sc_s10_title">10 · Textfelder</string>
    <string name="sc_s10_desc">Outlined ist Standard. Leading-Icon, Error-State, Filled mehrzeilig, Disabled.</string>
    <string name="sc_s11_title">11 · Karten</string>
    <string name="sc_s11_desc">Drei Varianten: Filled (auf Surface-Variant), Elevated (mit Tonal-Elevation), Outlined.</string>
    <string name="sc_s12_title">12 · Listeneinträge</string>
    <string name="sc_s12_desc">Ein-, zwei- und dreizeilige Varianten. Leading-Avatar 44dp, Trail-Text in monospace.</string>
    <string name="sc_s13_title">13 · Auswahl-Steuerelemente</string>
    <string name="sc_s13_desc">Checkbox, Switch, Radio-Group. Native-Ersatz mit AA-Kontrast.</string>
    <string name="sc_s14_title">14 · Segmented Buttons</string>
    <string name="sc_s14_desc">Single-Choice-Row für mutually-exclusive Auswahl (z. B. Tag / Woche / Monat / Jahr).</string>
    <string name="sc_s15_title">15 · Slider &amp; Fortschritt</string>
    <string name="sc_s15_desc">Slider stufenlos / mit Stufen / deaktiviert. Progress linear &amp; circular, je determinate und indeterminate.</string>
    <string name="sc_s16_title">16 · Badges &amp; Status-Pills</string>
    <string name="sc_s16_desc">Number-Badge auf Icon, Dot-Badge, Status-Pills für alle Rollen.</string>
    <string name="sc_s17_title">17 · Banner</string>
    <string name="sc_s17_desc">Inline-Hinweis-Streifen pro Rolle. Mit Aktion, prominentem Stil und „✕“ zum Schließen.</string>
    <string name="sc_s18_title">18 · Snackbar &amp; Dialog</string>
    <string name="sc_s18_desc">Snackbar mit Action-Button. Dialog mit 28dp Top-Radius.</string>
    <string name="sc_s19_title">19 · Icons</string>
    <string name="sc_s19_desc">Auf Web: Lucide (gleicher Strich, gleicher Stil wie Material Symbols).</string>
    <string name="sc_s20_title">20 · Trennlinien</string>
    <string name="sc_s20_desc">Horizontal / horizontal stark / vertikal.</string>
    <string name="sc_s21_title">21 · Spacing &amp; Radien</string>
    <string name="sc_s21_desc">8dp-Grid. Radii nach M3-Shape-Skala.</string>
    <string name="sc_s22_title">22 · App-Header (mobil)</string>
    <string name="sc_s22_desc">Höhere Kopfzeile mit Trennlinie an der Unterkante. Drei Buttons à exakt einem Drittel der Breite; Icon und direkt darunter die Beschriftung, als Einheit zentriert. Rechts das Zahnrad (Einstellungen), mittig das App-Symbol (Hauptseite), links ein drittes Symbol bei 2-Seiten-Apps oder ein Burger zum Ausklappen bei mehrseitigen Apps.</string>
    <string name="sc_ah_list">Liste</string>
    <string name="sc_ah_calendar">Kalender</string>
    <string name="sc_ah_history">Verlauf</string>
    <string name="sc_ah_cap_a">Variante A · 2-Seiten — drittes Symbol links</string>
    <string name="sc_ah_cap_b">Variante B · mehrseitig — Burger links</string>
    <string name="sc_ah_cap_default">State · Default (flach)</string>
    <string name="sc_ah_cap_elevated">State · Elevated (Inhalt gescrollt)</string>
    <string name="sc_ah_cap_badge">State · Aktive Seite + Badge</string>
    <string name="sc_ah_cap_drawer">State · Burger ausgeklappt (Navigation-Drawer)</string>
    <string name="sc_s23_title">23 · Einstellungen — Listenseite</string>
    <string name="sc_s23_desc">Jeder Unterpunkt nimmt eine ganze, komplett klickbare Zeile ein; rechts ein Pfeil. Hauptbezeichnung mit optionalem Beschreibungstext darunter, dazwischen eine Trennlinie.</string>
    <string name="sc_s24_title">24 · Einstellungen — Unterseite</string>
    <string name="sc_s24_desc">Gruppe „Allgemein“ mit Design-Dropdown (Systemstandard · Hell · Dunkel). Weitere Überschriften mit Beispiel-Reglern; jeder Gruppeninhalt sitzt in einem leicht farbigen Kästchen, getrennt durch eine Trennlinie vor der nächsten Überschrift.</string>
    <string name="sc_set_list_cap">Einstellungen · Unterpunkte mit Pfeil</string>
    <string name="sc_set_detail_cap">Anzeige · Gruppen + Dropdown + Regler</string>

