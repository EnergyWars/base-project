    <!-- Sections 25–33 · list patterns -->
    <string name="sc_s25_title">25 · Filterable list</string>
    <string name="sc_s25_desc">Search field plus filter chips above a list. Typing filters live by name/description; chips narrow to a category. Match counter top right, empty state when nothing matches.</string>
    <string name="sc_s26_title">26 · Drag &amp; drop list</string>
    <string name="sc_s26_desc">Sortable list — grab items by the handle and reorder. While dragging the card lifts; the target is highlighted. Rank numbers update after dropping.</string>
    <string name="sc_s27_title">27 · List with selection &amp; delete</string>
    <string name="sc_s27_desc">Multi-select via checkbox: selected rows turn light blue, an action bar with count and bulk delete appears on top. Each row also has its own delete button.</string>
    <string name="sc_s28_title">28 · Plain list (no prefix)</string>
    <string name="sc_s28_desc">List rows without an avatar/icon box — text only, optionally with a trailing value. Active or highlighted rows use light blue (primary container); one variant adds a small colored dot as a marker.</string>
    <string name="sc_s29_title">29 · Grouped list</string>
    <string name="sc_s29_desc">Items in sections with sticky group headers — typical for alphabetical or categorized directories. The header stays pinned while scrolling.</string>
    <string name="sc_s30_title">30 · Expandable list</string>
    <string name="sc_s30_desc">Items with hidden content that expands on tap — for FAQs, details or nested options. The arrow rotates when opening.</string>
    <string name="sc_s31_title">31 · List with trailing controls</string>
    <string name="sc_s31_desc">Rows with a control on the right — switch to toggle, checkbox as a task list, or a counter badge. Optional icon box as a leading element.</string>
    <string name="sc_s32_title">32 · Outlined container surfaces</string>
    <string name="sc_s32_desc">Like the section boxes on the settings page — in all six semantic colors with six steps each: outline only, faint to medium tint over the surface, full container fill, and the solid color. Each step keeps AA readability.</string>
    <string name="sc_s33_title">33 · Combined list</string>
    <string name="sc_s33_desc">All list capabilities in one view: live searchable and filterable by category, reorderable by handle (drag &amp; drop), with multi-select, bulk delete on top and a per-row delete button.</string>

